{
  "expo": {
    "name": "facturix",
    "slug": "facturix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/facturix-logo.png",
    "scheme": "facturix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/facturix-logo.png",
      "bundleIdentifier": "io.granix.facturix"
    },
    "android": {
      "package": "io.granix.facturix",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/images/facturix-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/facturix-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/facturix-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/images/facturix-logo.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15a8529c-6a3b-4394-9280-a615c9ad3751"
      }
    },
    "owner": "hericraft"
  }
}